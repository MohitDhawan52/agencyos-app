# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.

# NEW Supabase project (do not reuse the internal CRM's project)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard → Account & Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → secret you set for /api/billing/webhook
RAZORPAY_WEBHOOK_SECRET=
# Razorpay → Subscriptions → Plans: create monthly plans at ₹999 / ₹2,500 / ₹9,999 and paste their ids
RAZORPAY_PLAN_STARTER=plan_xxxxx
RAZORPAY_PLAN_GROWTH=plan_xxxxx
RAZORPAY_PLAN_PRO=plan_xxxxx
